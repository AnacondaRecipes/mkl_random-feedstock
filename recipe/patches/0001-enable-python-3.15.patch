From 4b0030bd9448cc8e23ac5efc80c09985e51d3cda Mon Sep 17 00:00:00 2001
From: Serhii Kupriienko <skupriienko@anaconda.com>
Date: Wed, 7 Oct 2026 15:21:52 +0000
Subject: [PATCH] Allow Python 3.15 in requires-python

Upstream 1.4.1 still declares requires-python >=3.10,<3.15. Widen the upper bound to <3.16 so the package can be built and installed against Python 3.15.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 0476dba..f181c81 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -69,7 +69,7 @@ keywords = [
 license = "BSD-3-Clause"
 name = "mkl_random"
 readme = {file = "README.md", content-type = "text/markdown"}
-requires-python = ">=3.10,<3.15"
+requires-python = ">=3.10,<3.16"
 
 [project.optional-dependencies]
 test = ["pytest"]
