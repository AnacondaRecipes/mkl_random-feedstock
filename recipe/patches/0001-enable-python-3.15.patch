From ca71c240b3168e8b6f7f89857677bc1fbf1c8f36 Mon Sep 17 00:00:00 2001
From: Serhii Kupriienko <skupriienko@anaconda.com>
Date: Wed, 7 Oct 2026 18:48:27 +0000
Subject: [PATCH] Allow Python 3.15 in requires-python

Upstream 1.5.0 still declares requires-python >=3.10,<3.15. Widen the upper bound to <3.16 so the package can be built and installed against Python 3.15.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index c841c9a..2abcb98 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -76,7 +76,7 @@ keywords = [
 license = "BSD-3-Clause"
 name = "mkl_random"
 readme = {file = "README.md", content-type = "text/markdown"}
-requires-python = ">=3.10,<3.15"
+requires-python = ">=3.10,<3.16"
 
 [project.optional-dependencies]
 test = ["pytest"]
